{
  "name": "@boat/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "create-admin": "tsx src/cli/create-admin.ts",
    "build": "prisma generate && tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "db:migrate": "prisma migrate deploy && prisma db execute --file prisma/grants.sql"
  },
  "dependencies": {
    "@boat/domain": "workspace:*",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.0",
    "nodemailer": "10.1.7",
    "openid-client": "6.8.8",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@boat/oidc-stub": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "pg": "8.23.1",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vitest": "5.0.4"
  }
}
