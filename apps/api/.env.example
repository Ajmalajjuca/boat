# Owner connection. Only the Prisma CLI uses it (migrations, grants). On Neon: the direct URL.
DIRECT_URL=postgresql://boat:boat@localhost:5432/boat
# App connection as boat_app, which cannot DELETE. On Neon: the pooled URL.
DATABASE_URL=postgresql://boat_app:boat_app@localhost:5432/boat
PORT=3000
LOG_LEVEL=info
# Signs CSRF tokens. Any random string of 32 or more characters: openssl rand -base64 48
SESSION_SECRET=dev-only-secret-change-me-0123456789abcdef
# The web app's address. Google sends people back here, and access emails link to it.
APP_URL=http://localhost:5173
# Leave unset in development: emails are written to the log instead of sent.
# Either Resend, which needs a domain verified in Resend:
# RESEND_API_KEY=
# MAIL_FROM="BOAT <noreply@your-domain>"
# Or SMTP, e.g. Gmail with an App Password (https://myaccount.google.com/apppasswords):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS="abcd efgh ijkl mnop"
# MAIL_FROM="BOAT <you@gmail.com>"
# Google sign-in for staff. Leave all three unset to allow only the backup admin's password.
# In the company's Google Cloud project: APIs & Services -> OAuth consent screen, user type
# Internal; then Credentials -> Create credentials -> OAuth client ID, type Web application, with
# the authorised redirect URI ${APP_URL}/api/v1/auth/google/callback (locally
# http://localhost:5173/api/v1/auth/google/callback).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Company Workspace domains, comma-separated. Users must be added with an address on one of them.
# GOOGLE_ALLOWED_DOMAINS=your-company.com
# Proxy hops in front of the app. 0 locally; Render sets 1.
TRUST_PROXY=0
# GRN receipts are hidden for now. on brings back their screens and routes.
# FEATURE_GRN=off
